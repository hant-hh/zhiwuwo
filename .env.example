# ===== 基础 =====
ENV=dev
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-string
LOG_LEVEL=info

# ===== 数据库 / 缓存 =====
PG_USER=zhiwuwo
PG_PASSWORD=change-me
PG_DB=zhiwuwo
DATABASE_URL=postgresql+psycopg2://zhiwuwo:change-me@postgres:5432/zhiwuwo
REDIS_URL=redis://redis:6379/0

# ===== 对象存储（开发期用 MinIO，生产替换为云 OSS/COS） =====
OSS_ENDPOINT=http://minio:9000
OSS_ACCESS_KEY=minioadmin
OSS_SECRET_KEY=minioadmin
OSS_BUCKET=zhiwuwo

# ===== AI 解析（Agnes 2.5 Flash，OpenAI 兼容 Chat Completions） =====
# 体验期免费；API Key 只填在 .env，不要提交进 Git
LLM_API_KEY=
LLM_BASE_URL=https://api.agnes-ai.cn/v1
LLM_MODEL=agnes-2.5-flash
LLM_TIMEOUT=8
# rule=纯规则（零成本）；llm=Agnes 2.5 Flash（失败自动回退 rule）
PARSER_BACKEND=llm
# 隐私开关：false 时不把录入文本发给第三方 AI
LLM_CONSENT=true

# ===== 语音（M2 预留） =====
ASR_API_KEY=

# ===== 推送（预留） =====
APNS_CERT_PATH=
FCM_SERVER_KEY=

# ===== 域名与 HTTPS（移动端内测前置） =====
DOMAIN=zhiwuwo.com
ACME_EMAIL=admin@zhiwuwo.com
# 对外只用非常用端口；容器内 nginx 固定监听 18080 / 18443
WEB_PORT=18080
WEB_HTTPS_PORT=18443
# 公网 80 平时不开放，签发证书时 ./deploy/issue-cert.sh 会临时开放用于 ACME HTTP-01
# 域名解析生效后执行 ./deploy/issue-cert.sh 签发正式证书

# ===== 跨域与前端注入 =====
# 非标准 HTTPS 端口必须显式写进来源，否则浏览器跨域会被拒
CORS_ORIGINS=http://localhost:3000,http://localhost:18080,https://zhiwuwo.com:18443,https://www.zhiwuwo.com:18443,https://app.zhiwuwo.com:18443
VITE_API_BASE_URL=http://localhost:8000
# App 通过同源 /api 访问，原生请求不受 CORS 限制

# ===== 镜像构建（仅 deploy/start.sh 使用） =====
# host 复用宿主机 DNS；若 BuildKit 禁用 host，改为 bridge 并在
# /etc/docker/daemon.json 配 "dns": ["223.5.5.5","114.114.114.114"]
BUILD_NETWORK=host
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
# 改过 Dockerfile / requirements.txt / package.json 后置 1 强制重建
REBUILD=0
# 服务器需代理上网时按需填写，会作为 build-arg 透传且不写入最终镜像
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=
